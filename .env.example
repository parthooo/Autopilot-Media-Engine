# Neon PostgreSQL — pooled URL for app runtime (host contains -pooler)
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/autopilot?sslmode=require&pgbouncer=true"
# Neon direct URL for Prisma migrations (host without -pooler)
DIRECT_URL="postgresql://user:password@host.neon.tech/autopilot?sslmode=require"

# Dashboard password (free Vercel auth) — leave unset locally to skip login during dev
SITE_PASSWORD="choose-a-strong-password"

# Reddit OAuth (required since May 2026 — create script app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID="your-client-id-under-app-name"
REDDIT_CLIENT_SECRET="your-client-secret"
REDDIT_USER_AGENT="autopilot-media-engine:1.0.0 (by /u/yourusername)"

# Google AI Studio (free) — required for AI auto-select winner
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-latest"

# YouTube Data API v3 (free 10k units/day) — optional, enable youtube source after adding
# YOUTUBE_API_KEY="your-youtube-api-key"

# Optional: trigger GitHub Actions from Vercel dashboard buttons
# GITHUB_TOKEN="ghp_..."
# GITHUB_REPOSITORY="your-username/autopilot-media-engine"
# GITHUB_REF="main"

# Optional: Pexels stock footage for video render (free API key at pexels.com/api)
# Strongly recommended for watchable B-roll — without this, renders use motion slides only.
# PEXELS_API_KEY="your-pexels-api-key"

# Optional: Edge TTS voices (defaults: Andrew long-form, Ava Shorts)
# EDGE_TTS_VOICE_LONG="en-US-AndrewNeural"
# EDGE_TTS_VOICE_SHORT="en-US-AvaNeural"
